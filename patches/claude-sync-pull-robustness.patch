+// A pull killed after writing a file but before saving state leaves local equal
+// to remote yet different from state; that must not be reported as a conflict.
+func TestNoConflictWhenLocalMatchesRemote(t *testing.T) {
+	env := setupTestEnv(t)
+	ctx := context.Background()
+
+	writeFile(t, env.claudeDir, "history.jsonl", `{"event":"v1"}`)
+	if _, err := env.syncer.Push(ctx); err != nil {
+		t.Fatalf("Push failed: %v", err)
+	}
+
+	writeFile(t, env.claudeDir, "history.jsonl", `{"event":"v2"}`)
+	encrypted, err := env.syncer.encryptor.Encrypt([]byte(`{"event":"v2"}`))
+	if err != nil {
+		t.Fatalf("Encrypt failed: %v", err)
+	}
+	time.Sleep(10 * time.Millisecond)
+	if err := env.store.Upload(ctx, "history.jsonl.age", encrypted); err != nil {
+		t.Fatalf("Upload to mock failed: %v", err)
+	}
+
+	for i := 0; i < 2; i++ {
+		result, err := env.syncer.Pull(ctx)
+		if err != nil {
+			t.Fatalf("Pull %d failed: %v", i, err)
+		}
+		if len(result.Conflicts) != 0 {
+			t.Errorf("Pull %d: expected 0 conflicts, got %v", i, result.Conflicts)
+		}
+	}
+
+	entries, err := os.ReadDir(env.claudeDir)
+	if err != nil {
+		t.Fatalf("ReadDir failed: %v", err)
+	}
+	for _, e := range entries {
+		if strings.Contains(e.Name(), ".conflict.") || strings.HasSuffix(e.Name(), ".tmp") {
+			t.Errorf("Unexpected leftover file %s", e.Name())
+		}
+	}
+}
