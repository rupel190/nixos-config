+package r2
+
+import (
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestPacedConnHoldsRate(t *testing.T) {
+	client, server := net.Pipe()
+	defer client.Close()
+	go func() { _, _ = io.Copy(io.Discard, server) }()
+
+	// 1024 kbit/s = 128 KB/s; 64 KB is four 16 KB chunks, three of them paced
+	c := &pacedConn{Conn: client, p: &pacer{bytesPerSec: 1024 * 1000 / 8}}
+	start := time.Now()
+	n, err := c.Write(make([]byte, 64<<10))
+	elapsed := time.Since(start)
+	if err != nil || n != 64<<10 {
+		t.Fatalf("Write: n=%d err=%v", n, err)
+	}
+	if elapsed < 300*time.Millisecond || elapsed > 2*time.Second {
+		t.Errorf("64 KB at 128 KB/s took %v, want ~380ms", elapsed)
+	}
+}
+
+func TestThrottleOffWithoutEnv(t *testing.T) {
+	t.Setenv(UploadLimitEnv, "")
+	if throttledHTTPClient() != nil {
+		t.Error("expected no throttled client when the env var is unset")
+	}
+	t.Setenv(UploadLimitEnv, "5000")
+	if throttledHTTPClient() == nil {
+		t.Error("expected a throttled client at 5000 kbit")
+	}
+}
