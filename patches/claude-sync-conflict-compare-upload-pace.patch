diff --git a/internal/storage/r2/throttle.go b/internal/storage/r2/throttle.go
new file mode 100644
index 0000000..304b11b
--- /dev/null
+++ b/internal/storage/r2/throttle.go
@@ -0,0 +1,75 @@
+package r2
+
+import (
+	"context"
+	"net"
+	"net/http"
+	"os"
+	"strconv"
+	"sync"
+	"time"
+)
+
+// UploadLimitEnv caps outgoing bytes on every connection, in kilobits per second.
+const UploadLimitEnv = "CLAUDE_SYNC_UPLOAD_KBIT"
+
+// throttledHTTPClient returns nil unless UploadLimitEnv is set to a positive number.
+func throttledHTTPClient() *http.Client {
+	kbit, err := strconv.Atoi(os.Getenv(UploadLimitEnv))
+	if err != nil || kbit <= 0 {
+		return nil
+	}
+	p := &pacer{bytesPerSec: float64(kbit) * 1000 / 8}
+	dialer := &net.Dialer{Timeout: 30 * time.Second, KeepAlive: 30 * time.Second}
+	tr := http.DefaultTransport.(*http.Transport).Clone()
+	tr.DialContext = func(ctx context.Context, network, addr string) (net.Conn, error) {
+		c, err := dialer.DialContext(ctx, network, addr)
+		if err != nil {
+			return nil, err
+		}
+		return &pacedConn{Conn: c, p: p}, nil
+	}
+	return &http.Client{Transport: tr}
+}
+
+// pacer is shared by all connections, so parallel uploads split one budget.
+type pacer struct {
+	mu          sync.Mutex
+	bytesPerSec float64
+	next        time.Time
+}
+
+func (p *pacer) wait(n int) {
+	p.mu.Lock()
+	now := time.Now()
+	if p.next.Before(now) {
+		p.next = now
+	}
+	d := p.next.Sub(now)
+	p.next = p.next.Add(time.Duration(float64(n) / p.bytesPerSec * float64(time.Second)))
+	p.mu.Unlock()
+	if d > 0 {
+		time.Sleep(d)
+	}
+}
+
+type pacedConn struct {
+	net.Conn
+	p *pacer
+}
+
+func (c *pacedConn) Write(b []byte) (int, error) {
+	const chunk = 16 << 10
+	written := 0
+	for len(b) > 0 {
+		n := min(len(b), chunk)
+		c.p.wait(n)
+		w, err := c.Conn.Write(b[:n])
+		written += w
+		if err != nil {
+			return written, err
+		}
+		b = b[n:]
+	}
+	return written, nil
+}
