+// compareRemote reports whether a downloaded remote copy holds nothing local lacks.
+// Path tokens are lossy (a literal "${HOME}" comes back as the home path), so both
+// sides are compared after resolving. older: an append-only transcript whose remote
+// copy is an earlier snapshot of local, e.g. our own upload whose state was never saved.
+func (s *Syncer) compareRemote(relativePath string, local, remote []byte) (same, older bool) {
+	if IsPortableContentPath(relativePath) {
+		local = s.paths.ResolveContent(local)
+		remote = s.paths.ResolveContent(remote)
+	}
+	if bytes.Equal(local, remote) {
+		return true, false
+	}
+	base := relativePath
+	if i := strings.Index(base, ".conflict."); i >= 0 {
+		base = base[:i]
+	}
+	if strings.HasSuffix(base, ".jsonl") && len(remote) > 0 && bytes.HasPrefix(local, remote) {
+		return false, true
+	}
+	return false, false
+}
