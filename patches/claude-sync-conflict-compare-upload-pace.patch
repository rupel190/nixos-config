+package sync
+
+import (
+	"context"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestCompareRemoteHomeTokenAndPrefix(t *testing.T) {
+	pm, err := NewPathMapper("/home/alice", nil)
+	if err != nil {
+		t.Fatalf("NewPathMapper: %v", err)
+	}
+	s := &Syncer{paths: pm}
+	local := []byte("{\"t\":\"env X=${HOME}/a\"}\n{\"cwd\":\"/home/alice/p\"}\n")
+	// What a pull writes back: the literal token came home as the path
+	roundTripped := []byte("{\"t\":\"env X=/home/alice/a\"}\n{\"cwd\":\"/home/alice/p\"}\n")
+
+	cases := []struct {
+		name        string
+		path        string
+		remote      []byte
+		same, older bool
+	}{
+		{"home token round trip", "projects/p/s.jsonl", roundTripped, true, false},
+		{"earlier snapshot", "projects/p/s.jsonl", []byte("{\"t\":\"env X=/home/alice/a\"}\n"), false, true},
+		{"diverged", "projects/p/s.jsonl", []byte("{\"t\":\"other\"}\n"), false, false},
+		{"prefix of non-transcript", "settings.json", local[:10], false, false},
+		{"empty remote", "projects/p/s.jsonl", nil, false, false},
+	}
+	for _, c := range cases {
+		same, older := s.compareRemote(c.path, local, c.remote)
+		if same != c.same || older != c.older {
+			t.Errorf("%s: got same=%v older=%v, want same=%v older=%v", c.name, same, older, c.same, c.older)
+		}
+	}
+}
+
+func TestPullTreatsEarlierRemoteSnapshotAsOlder(t *testing.T) {
+	env := setupTestEnv(t)
+	ctx := context.Background()
+	rel := filepath.Join("projects", "p", "s.jsonl")
+
+	writeFile(t, env.claudeDir, rel, "{\"n\":1}\n")
+	if _, err := env.syncer.Push(ctx); err != nil {
+		t.Fatalf("Push failed: %v", err)
+	}
+	writeFile(t, env.claudeDir, rel, "{\"n\":1}\n{\"n\":2}\n")
+
+	// Our own earlier upload, landing after the state's Uploaded time (a push whose state was lost)
+	encrypted, err := env.syncer.encryptor.Encrypt([]byte("{\"n\":1}\n"))
+	if err != nil {
+		t.Fatalf("Encrypt failed: %v", err)
+	}
+	time.Sleep(10 * time.Millisecond)
+	if err := env.store.Upload(ctx, env.syncer.remoteKey(rel), encrypted); err != nil {
+		t.Fatalf("Upload to mock failed: %v", err)
+	}
+
+	for i := 0; i < 2; i++ {
+		result, err := env.syncer.Pull(ctx)
+		if err != nil {
+			t.Fatalf("Pull %d failed: %v", i, err)
+		}
+		if len(result.Conflicts) != 0 {
+			t.Errorf("Pull %d: expected 0 conflicts, got %v", i, result.Conflicts)
+		}
+	}
+	matches, _ := filepath.Glob(filepath.Join(env.claudeDir, "projects", "p", "*.conflict.*"))
+	if len(matches) != 0 {
+		t.Errorf("Unexpected conflict copies: %v", matches)
+	}
+
+	changes, err := env.syncer.Status(ctx)
+	if err != nil {
+		t.Fatalf("Status failed: %v", err)
+	}
+	found := false
+	for _, c := range changes {
+		if c.Path == rel && strings.EqualFold(c.Action, "modify") {
+			found = true
+		}
+	}
+	if !found {
+		t.Errorf("expected %s to be pending upload, changes: %+v", rel, changes)
+	}
+}
